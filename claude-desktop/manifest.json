{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/mcpb/main/schemas/mcpb-manifest-v0.3.schema.json",
  "manifest_version": "0.3",
  "name": "polypane",
  "display_name": "Polypane",
  "version": "32.0.0",
  "description": "Build, check and fix websites in Polypane, the browser for web developers: every viewport at once, with its accessibility, layout, meta and performance checks. Needs Polypane, which has a free trial.",
  "author": {
    "name": "Polypane",
    "email": "support@polypane.app",
    "url": "https://polypane.app"
  },
  "homepage": "https://polypane.app",
  "documentation": "https://polypane.app/docs/automation/",
  "support": "https://polypane.app/support/",
  "license": "LicenseRef-Proprietary",
  "privacy_policies": [
    "https://polypane.app/privacy/"
  ],
  "icon": "icon.png",
  "keywords": [
    "polypane",
    "browser",
    "responsive",
    "accessibility",
    "testing",
    "web-development",
    "mcp"
  ],
  "server": {
    "type": "binary",
    "entry_point": "/opt/Polypane/polypane",
    "mcp_config": {
      "command": "/opt/Polypane/polypane",
      "args": [
        "--mcp",
        "--client=claude-desktop",
        "--ozone-platform=headless"
      ],
      "platform_overrides": {
        "darwin": {
          "command": "/Applications/Polypane.app/Contents/MacOS/Polypane",
          "args": [
            "--mcp",
            "--client=claude-desktop"
          ]
        },
        "win32": {
          "command": "C:\\Program Files\\Polypane\\Polypane.exe",
          "args": [
            "--mcp",
            "--client=claude-desktop"
          ]
        }
      }
    }
  },
  "compatibility": {
    "claude_desktop": ">=0.10.0",
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ]
  },
  "tools_generated": true
}
